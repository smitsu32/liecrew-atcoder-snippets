	"input": {
		"prefix": "inp",
		"body": "input()"
	},
	"Integer Input": {
		"prefix": "ini",
		"body": "int(input())"
	},
	"Map Input": {
		"prefix": "ma",
		"body": "map(int,input().split())"
	},
	"List Input": {
		"prefix": "lis",
		"body": "list(map(int,input().split()))"
	},
	"Repeat": {
		"prefix": "rep",
		"body": [
			"for i in range(n)"
		]
	},
	"Repeatj": {
		"prefix": "repj",
		"body": [
			"for j in range(m)"
		]
	},
	"Yes": { 
		"prefix": "yes",
		"body": "print('Yes')"
	},
	"No": { 
		"prefix": "no",
		"body": "print('No')"
	},
	"bit brute force": { 
		"prefix": "bitb",
		"body":[
			"for bit in range(1<<n):",
			"\tuse=[False]*n",
			"\tfor i in range(n):",
			"\t\tif bit & (1<<i):",
			"\t\t\tuse[i]=True",
			"\tfor i in range(n):",
			"\t\tif use[i]:",
			"\t\t\t$0"
		]
	},
	"credits": { 
		"prefix": "cre",
		"body": "# このコードは次のスニペットを利用して書いています：https://github.com/smitsu32/vscode-python-snippets"
	}
